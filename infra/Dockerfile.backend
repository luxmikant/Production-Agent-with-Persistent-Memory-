FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod ./
RUN go mod download || true
COPY . ./
RUN go build -o /out/stillmind ./cmd/stillmind

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /out/stillmind /usr/local/bin/stillmind
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/stillmind"]
