# --- CockroachDB ---
# Free tier cluster works well for hackathon. Use connection string from
# CockroachDB Cloud console or local docker-compose.
CRDB_URL=postgresql://root@localhost:26257/defaultdb?sslmode=disable
# For CockroachDB Cloud:
# CRDB_URL=postgresql://user:pass@host:26257/defaultdb?sslmode=verify-full

# --- AWS ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Bedrock (cost-efficient free-tier defaults) ---
# Claude 3 Haiku: cheapest Claude on Bedrock at time of writing.
BEDROCK_MODEL=anthropic.claude-3-haiku-20240307-v1:0
# Titan Embeddings v2: 1024-dim, cheap, sufficient for memory recall.
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
EMBED_DIM=1024

# --- Server ---
PORT=8080
DEMO_TENANT_ID=demo-tenant

# --- Compaction ---
COMPACT_BUDGET_TOKENS=4000
COMPACT_PRESSURE_THRESHOLD=0.85
COMPACT_MIN_INTERVAL_S=60
